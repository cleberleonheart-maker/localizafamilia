{
  "rules": {
    "_diag": {
      ".read": false,
      "$device": {
        "$tipo": {
          ".write": "auth != null && newData.hasChildren(['data'])"
        }
      }
    },
    "familia": {
      ".read": "auth != null",
      "config": {
        "senha": {
          ".write": "auth != null && (!data.exists() || data.val() == '')"
        }
      },
      "$membro": {
        "diag": { ".read": false, ".write": false },
        "$campo": {
          ".write": "auth != null",
          ".validate": "newData.isString() ? newData.val().length <= 500 : newData.isBoolean() || newData.isNumber()"
        }
      }
    },
    "historico": {
      ".read": "auth != null",
      "$chave": {
        "$ts": {
          ".write": "auth != null && $ts.matches(/^[0-9]{13}$/)"
        }
      }
    },
    "chat": {
      ".read": "auth != null",
      "$msg": {
        ".write": "auth != null",
        ".validate": "newData.isString() ? newData.val().length <= 2000 : true"
      }
    },
    "tarefas": {
      ".read": "auth != null",
      "$tarefa": {
        ".write": "auth != null",
        ".validate": "newData.isString() ? newData.val().length <= 2000 : true"
      }
    },
    "sos": {
      ".read": "auth != null",
      "alerta": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['nome','lat','lng','t']) && newData.child('nome').isString() && newData.child('nome').val().length <= 100 && newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('t').isNumber()"
      },
      "$vetor": {
        ".write": "auth != null"
      }
    }
  }
}