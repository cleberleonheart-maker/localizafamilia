{
  "rules": {
    "_diag": {
      ".read": false,
      "$device": {
        "$tipo": {
          ".write": "auth != null && newData.hasChildren(['data'])"
        }
      }
    },
    "familia": {
      ".read": "auth != null",
      "config": {
        "senha": {
          ".write": "auth != null && (!data.exists() || data.val() == '')"
        }
      },
      "$membro": {
        "diag": { ".read": false, ".write": false },
        "$campo": {
          ".write": "auth != null"
        }
      }
    },
    "historico": {
      ".read": "auth != null",
      "$chave": {
        "$ts": {
          ".write": "auth != null"
        }
      }
    },
    "chat": {
      ".read": "auth != null",
      "$msg": {
        ".write": "auth != null"
      }
    },
    "tarefas": {
      ".read": "auth != null",
      "$tarefa": {
        ".write": "auth != null"
      }
    },
    "sos": {
      ".read": "auth != null",
      "$vetor": {
        ".write": "auth != null"
      }
    }
  }
}