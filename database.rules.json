{
  "rules": {
    "_diag": {
      ".read": false,
      "$device": {
        "$tipo": {
          ".write": "newData.hasChildren(['data'])"
        }
      }
    },
    "familia": {
      ".read": true,
      "config": {
        "senha": {
          ".write": "!data.exists() || data.val() == ''"
        }
      },
      "$membro": {
        "diag": { ".read": false, ".write": false },
        "$campo": {
          ".write": true
        }
      }
    },
    "historico": {
      ".read": true,
      "$chave": {
        "$ts": {
          ".write": true
        }
      }
    },
    "chat": {
      ".read": true,
      "$msg": {
        ".write": true
      }
    },
    "tarefas": {
      ".read": true,
      "$tarefa": {
        ".write": true
      }
    },
    "sos": {
      ".read": true,
      "$vetor": {
        ".write": true
      }
    }
  }
}